{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "packages/zai-coding-plan",
      "packages/inference-self-host",
      "packages/protect-secrets",
      "packages/statusline",
      "packages/user-input-history",
      "packages/user-message",
      "packages/tool-display",
      "packages/subagents",
      "packages/extra-tools",
      "packages/ask-user-question",
      "packages/context-usage",
      "packages/goal",
      "packages/btw",
      "packages/memory",
      "packages/committer",
      "packages/extension-config-ui",
      "packages/web-tools",
      "packages/message-queue",
      "packages/auto-compact",
      "packages/voice-input",
      "packages/read-tracker",
      "packages/working-indicator",
      "packages/todo",
      "packages/moshi-hooks-extra"
    ],
    "skills": [
      "skills/code-philosophy",
      "skills/design-an-interface",
      "skills/obsidian-bases",
      "skills/obsidian-markdown",
      "skills/todoist",
      "skills/write-a-skill"
    ],
    "themes": [
      "themes/catppuccin-mocha.json"
    ],
    "prompts": [
      "prompts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.79.10",
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "^0.79.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "test": "vitest run",
    "format": "prettier --write packages"
  }
}
