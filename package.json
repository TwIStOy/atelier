{
  "name": "pi-extensions",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "pi": {
    "extensions": [
      "packages/common/src/log-warning.ts",
      "packages/tool-call-fixer",
      "packages/loop-guard",
      "packages/tool-timeout",
      "packages/zai-coding-plan",
      "packages/toori",
      "packages/statusline",
      "packages/user-input-history",
      "packages/user-message",
      "packages/tool-display",
      "packages/subagents",
      "packages/extra-tools",
      "packages/ask-user-question",
      "packages/context-usage",
      "packages/goal",
      "packages/btw",
      "packages/memory",
      "packages/committer",
      "packages/extension-config-ui",
      "packages/web-tools",
      "packages/message-queue",
      "packages/auto-compact",
      "packages/read-tracker",
      "packages/working-indicator",
      "packages/compact-thinking",
      "packages/todo",
      "packages/moshi-hooks-extra",
      "packages/herdr",
      "packages/truncate-outputs",
      "packages/experience",
      "packages/htw-producer",
      "packages/agents-mirror",
      "packages/workflow",
      "packages/heap-probe",
      "packages/inject-prompt-by-model",
      "packages/canvas",
      "packages/apply-patch",
      "packages/recap"
    ],
    "skills": [
      "skills/code-philosophy",
      "skills/code-review",
      "skills/design-an-interface",
      "skills/diagnosing-bugs",
      "skills/domain-modeling",
      "skills/grilling",
      "skills/obsidian-bases",
      "skills/obsidian-markdown",
      "skills/seed-pi-session",
      "skills/tdd",
      "skills/todoist",
      "skills/write-a-skill"
    ],
    "themes": [
      "themes/ayu-dark.json",
      "themes/ayu-light.json",
      "themes/ayu-mirage.json",
      "themes/catppuccin-mocha.json",
      "themes/catppuccin-latte.json",
      "themes/github-dark-default.json",
      "themes/github-light-default.json"
    ],
    "prompts": [
      "prompts"
    ],
    "agents": [
      "./agents"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^26.1.2",
    "fallow": "^3.14.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "fmt": "biome check --write --error-on-warnings .",
    "check": "biome check --error-on-warnings .",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fallow:health": "fallow health --score --hotspots --targets",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes"
  }
}
