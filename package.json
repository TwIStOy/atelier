{
  "name": "pi-extensions",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "pi": {
    "extensions": [
      "packages/common/src/log-warning.ts",
      "packages/tool-call-fixer",
      "packages/tool-timeout",
      "packages/toori",
      "packages/magpie",
      "packages/statusline",
      "extensions/better-editor",
      "packages/user-message",
      "packages/tool-display",
      "packages/subagents",
      "packages/extra-tools",
      "packages/protect-secrets",
      "packages/ask-user-question",
      "packages/context-usage",
      "packages/goal",
      "packages/btw",
      "packages/committer",
      "packages/extension-config-ui",
      "packages/web-tools",
      "packages/message-queue",
      "packages/auto-compact",
      "packages/read-tracker",
      "extensions/working-indicator",
      "packages/compact-thinking",
      "packages/todo",
      "packages/truncate-outputs",
      "packages/experience",
      "packages/agents-mirror",
      "packages/workflow",
      "packages/heap-probe",
      "packages/inject-prompt-by-model",
      "packages/canvas",
      "packages/apply-patch",
      "packages/recap",
      "extensions/rex-title"
    ],
    "skills": [
      "skills/clice",
      "skills/code-philosophy",
      "skills/code-review",
      "skills/codebase-design",
      "skills/diagnosing-bugs",
      "skills/domain-modeling",
      "skills/grilling",
      "skills/obsidian-bases",
      "skills/obsidian-markdown",
      "skills/research",
      "skills/seed-pi-session",
      "skills/tdd",
      "skills/todoist",
      "skills/workflow-dsl",
      "skills/write-a-skill"
    ],
    "themes": [
      "themes/aura.json",
      "themes/ayu-dark.json",
      "themes/ayu-light.json",
      "themes/ayu-mirage.json",
      "themes/catppuccin-latte.json",
      "themes/catppuccin-mocha.json",
      "themes/github-dark-default.json",
      "themes/github-light-default.json",
      "themes/neon-green-light.json",
      "themes/neon-green.json",
      "themes/omarchy.json",
      "themes/opencode.json",
      "themes/synthwave-84.json",
      "themes/zed-dark.json",
      "themes/zed-light.json"
    ],
    "prompts": [
      "prompts"
    ],
    "agents": [
      "./agents"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "fallow": "^3.40.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "test": "vitest run",
    "fmt": "biome check --write --error-on-warnings .",
    "check": "biome check --error-on-warnings .",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fallow:health": "fallow health --score --hotspots --targets",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes"
  }
}
