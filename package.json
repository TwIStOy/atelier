  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.3",
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "^0.80.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@biomejs/biome": "2.5.2",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "test": "vitest run",
    "check": "biome check --write --error-on-warnings ."
  }
}
