{
  "name": "@htwang-contrib/apply-patch",
  "version": "0.7.0",
  "description": "Pi extension. Codex-style apply_patch freeform tool for OpenAI GPT models, ported from code-yeongyu/pi-apply-patch.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "apply-patch",
    "codex"
  ],
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./patch": "./src/patch.ts",
    "./preview": "./src/preview.ts"
  },
  "license": "MIT",
  "files": [
    "src"
  ],
  "dependencies": {
    "@htwang-contrib/common": "*",
    "diff": "^9.0.0",
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
