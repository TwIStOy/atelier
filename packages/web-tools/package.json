{
  "name": "@htwang-contrib/web-tools",
  "version": "0.5.0",
  "description": "Pi extension. Web search and fetch tools with pluggable providers (Brave, Tavily, Serper, Exa, You.com, Jina, Firecrawl, Perplexity).",
  "keywords": [
    "pi-package",
    "pi-extension",
    "web-search",
    "web-fetch",
    "search",
    "fetch",
    "ai",
    "llm",
    "agent"
  ],
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "MIT",
  "files": [
    "index.ts",
    "config.ts",
    "providers/",
    "search/",
    "fetch/"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@htwang-contrib/common": "*",
    "typebox": "1.3.28"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
